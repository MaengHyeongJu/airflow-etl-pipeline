# Copy to .env and fill in before `docker compose up`

# Host UID so Airflow-written files/logs aren't root-owned (run `id -u` to get this)
AIRFLOW_UID=50000

# Postgres superuser (used to create the `airflow` and `datamart` databases at init time)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Airflow metadata DB (lives in the same Postgres instance, separate database)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Data mart DB + roles
DATAMART_DB_NAME=datamart
DATAMART_ETL_USER=etl_writer
DATAMART_ETL_PASSWORD=etl_writer_pw
DATAMART_READER_USER=dashboard_reader
DATAMART_READER_PASSWORD=dashboard_reader_pw

# Airflow core secrets (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# Airflow admin UI user
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Airflow connection to the data mart (env-var connection, picked up automatically)
AIRFLOW_CONN_DATAMART_POSTGRES=postgresql://etl_writer:etl_writer_pw@postgres:5432/datamart

# Backend
DATAMART_READER_DSN=postgresql://dashboard_reader:dashboard_reader_pw@postgres:5432/datamart
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Frontend
VITE_API_BASE_URL=http://localhost:8000
